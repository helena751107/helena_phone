# ============================================================
#  YouTube 자동화 솔루션 — 환경변수 템플릿
#  이 파일을 .env 로 복사해서 아래 값만 채우면 install.sh 가
#  전부 자동 설정한다. (토큰만 있으면 브라우저 없이 바로 통제)
# ============================================================

# ── 1. 계정 정보 (필수) ───────────────────────────────────────
# 구글 계정 이메일 (브랜드 채널 소유 계정)
YT_ACCOUNT_EMAIL="you@gmail.com"
# 계정 구분자 (a/b/c/d 중 하나, 자동부여 안 쓰면 이 값 사용)
YT_ACCOUNT_ID="a"

# ── 2. 채널 정보 (필수, 여러 개는 ; 로 구분) ──────────────────
# 형식: 핸들|채널ID|레포명  (여러 채널: ; 로 연결)
YT_CHANNELS="@musician-parksy|UCun6b2HD3ekp35PhqbTfOlg|parksy-audio"

# ── 3. GCP OAuth 클라이언트 (필수 — 브라우저 인증할 때만) ─────
YT_CLIENT_ID=""
YT_CLIENT_SECRET=""
YT_GCP_PROJECT="parksy-youtube"

# ── 4. OAuth 리프레시 토큰 (있으면 브라우저 인증 생략) ────────
# 이게 있으면 setup 후 곧바로 API 통제 가능. 없으면 install 후
#   youtube_ctl.py auth  로 브라우저(폰 2FA) 인증 1회 필요.
YT_REFRESH_TOKEN=""

# ── 5. 브라우저 인증용 (선택) ─────────────────────────────────
# GUI 로그인 자동화할 때만. 파일에 평문 저장 금지, 실행 시 환경변수로.
YT_PASSWORD=""

# ── 6. 실행 환경 (선택) ───────────────────────────────────────
# headless 서버면 DISPLAY 안 쓰고, WSL/데스크톱이면 :0
YT_DISPLAY=":0"
# 업로드 기본: public | unlisted | private
YT_PRIVACY="public"
# 자막 기본 언어
YT_LANGUAGE="ko"
