# 🔐 비밀 환경변수 템플릿
# 📍 저장 위치: .secrets.env (절대 git에 올리지 마세요!)
#
# 이 파일을 복사해서 .secrets.env로 저장하고 값을 채우세요.
# .gitignore에 .secrets.env가 등록되어 있어야 안전합니다.

# ---- GitHub ----
# GitHub Personal Access Token (repo 권한 필요)
# 발급: Settings → Developer settings → Personal access tokens → Fine-grained tokens
GITHUB_TOKEN="ghp_여기에_토큰_입력"

# ---- Telegram 봇 ----
# 봇 토큰: @BotFather → /newbot → 발급받은 토큰
TG_TOKEN="8988031320:AAH_여기에_토큰_입력"
# 채팅방 ID: 봇이 메시지를 보낼 방의 숫자 ID
TG_CHAT="8579179811"

# ---- Discord ----
# 디스코드 계정 이메일/비번 (API 로그인용)
# 경고: 계정 토큰은 절대 타인 노출 금지
DISCORD_EMAIL="이메일@example.com"
DISCORD_PASS="비밀번호"

# ---- YouTube ----
# OAuth 2.0 클라이언트 ID (Google Cloud Console에서 발급)
# 발급: https://console.cloud.google.com/ → APIs & Services → Credentials
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Grok (xAI) API — console.x.ai
XAI_API_KEY=""
